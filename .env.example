# ===== TagEditor_Web 配置示例 =====
#
# 用法：复制成 .env，填上自己的值，然后 python app.py
#     Windows:  copy .env.example .env
#     Linux/Mac: cp .env.example .env
#
# .env 已被 git 忽略，密钥不会提交。下面的 Key 都是占位符，请替换成自己的。
# 改完直接生效，不用重启（按文件修改时间热加载）。


# ══════════════════════════════════════════════════════════════════════
#  一、必须填：模型接入
#     本工具的翻译、描述生成都要调大模型。两个端点，各管一摊：
#       LLM_TEXT_*    纯文本模型 —— 标签翻译、批量深度翻译
#       LLM_VISION_*  带视觉的模型 —— 看图写描述、提示词优化器
#     两者可以是同一个服务，也可以不同；都是 OpenAI 兼容接口。
# ══════════════════════════════════════════════════════════════════════

# ── 纯文本模型 ────────────────────────────────────────────────────────
LLM_TEXT_API_URL=https://api.deepseek.com
LLM_TEXT_API_KEY=sk-你的密钥
LLM_TEXT_MODEL=deepseek-chat

# ── 视觉模型（要能看图）──────────────────────────────────────────────
# 提示词优化器复用这一组，不用另外配
LLM_VISION_API_URL=http://127.0.0.1:8080/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=default


# ══════════════════════════════════════════════════════════════════════
#  二、必须填：Danbooru 凭据
#     同步标签库、抓 wiki、抓共现时需要。只用本地翻译功能可以不填。
# ══════════════════════════════════════════════════════════════════════

# 申请入口：https://danbooru.donmai.us/wiki_pages/help:api
DANBOORU_USER_NAME=你的用户名
DANBOORU_API_KEY=你的密钥
# 访问不通时才填代理，能直连就留空
DANBOORU_PROXY=


# ══════════════════════════════════════════════════════════════════════
#  三、本地模型：用哪个功能就配哪段，不用的整段删掉
# ══════════════════════════════════════════════════════════════════════

# ── WD14 自动打标 → 给图片生成标签 ───────────────────────────────────
# 目录里要有 model.onnx 和 selected_tags.csv
#   https://huggingface.co/SmilingWolf/wd-eva02-large-tagger-v3
TAGGER_MODEL_PATH=models/wd-eva02-large-tagger-v3

# 置信度阈值：调高 = 只保留更确信的标签（更准、更少）；
# 调低 = 更多、更全，也更容易混进噪声。角色标签通常给得比通用标签低
TAGGER_GENERAL_THRESHOLD=0.3
TAGGER_CHARACTER_THRESHOLD=0.1

# ── Real-ESRGAN 超清放大 ─────────────────────────────────────────────
#   https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth
REALESRGAN_MODEL_PATH=models/RealESRGAN_x4plus_anime_6B.pth

# ── BiRefNet 背景移除（ToonOut 动漫微调）────────────────────────────
# 需要「基础模型 + 微调权重」两部分配合
#   基础模型：https://huggingface.co/ZhengPeng7/BiRefNet
#   微调权重：https://huggingface.co/joelseytre/toonout
BIREFNET_BASE_DIR=models/birefnet-base
BIREFNET_WEIGHTS=models/toonout.pth


# ══════════════════════════════════════════════════════════════════════
#  四、按需调节：都有内置默认值，不写也能跑
# ══════════════════════════════════════════════════════════════════════

# ── Bangumi：深度翻译「角色/作品」时查证中文名 ───────────────────────
# 申请入口：https://next.bgm.tv/demo/access-token
# 注意：这个不是可有可无的开关。留空的话查证请求照样会发出去（只是不带认证头），
# 必然失败、还要白等一次网络超时。不做角色/作品翻译就把整行删掉。
BANGUMI_ACCESS_TOKEN=

# ── 输出长度与思考模式 ───────────────────────────────────────────────
# 单次回答的 token 上限。推理模型的「思考内容」也算在这个额度里，
# 额度被思考吃光就会得到空结果。翻译大段内容被截断时调大
LLM_TEXT_MAX_TOKENS=8192
# 视觉模型只写 2~3 句描述，额度小得多
LLM_VISION_MAX_TOKENS=1024

# 是否让模型先「思考」再回答。off 关闭（推荐）：
# 这两个任务都不需要推理，思考纯烧钱，而且思考模式下服务端会静默忽略 temperature
LLM_VISION_THINKING=off

# 单次请求超时（秒）。不配的话 SDK 默认 600 秒，端点卡住会挂很久
LLM_VISION_TIMEOUT=180

# ── 提示词优化器（页面 /prompt_tool）────────────────────────────────
# 它一轮跑三次调用（规划 / 带图改写 / 未收录修补），输出是逐条 diff，条目多，额度要大
PROMPT_TOOL_MAX_TOKENS=8192
PROMPT_TOOL_THINKING=off
PROMPT_TOOL_TIMEOUT=180

# ── 自然语言描述的保存方式 ───────────────────────────────────────────
# 生成描述时是否把已有的 .txt 标签也送给模型当参考（推荐 true，写得更贴图）
CAPTION_USE_TAGS_AS_HINT=true
# 生成结果存哪里：txt = 存进 .nl.txt（默认）；separate = 另存 .caption.txt
CAPTION_SAVE_AS=txt

# ── 日志 ─────────────────────────────────────────────────────────────
# 日志写到 logs/tageditor.log（单文件 5MB，保留 5 份）。
# 觉得控制台太吵就把 LOG_LEVEL 改成 WARNING；排查问题想看得更细就用 DEBUG。
# LOG_LEVEL=INFO          # 控制台级别
# LOG_FILE_LEVEL=INFO     # 文件级别
# LOG_DIR=logs            # 日志目录
# LOG_TO_FILE=false       # 设为 false 则只输出到控制台

# ── 其它 ─────────────────────────────────────────────────────────────
# 启动时预先加载模型，首次点击功能时不用等（占内存，默认关）
PRELOAD_MODELS=false

# 还有请求间隔、翻页、标签库路径等参数，都有合理默认值，
# 需要微调时见 README 的「配置说明」。
