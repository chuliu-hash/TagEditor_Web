# ===== TagEditor_Web 环境变量示例 =====
# 复制本文件为 .env 并填入实际值：cp .env.example .env （Windows: copy .env.example .env）
# .env 已被 git 忽略，密钥不会提交；API Key 一律为占位符，请勿在原文件中泄漏

# OpenAI 兼容 API 配置（LLM 深度翻译）
LLM_API_URL=https://api.deepseek.com
# 本地部署（Ollama / LM Studio / vLLM 等）不校验 Key，留空即可
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-v4-flash
# 单次输出上限。思考与正式回答共享额度，太小会返回空 content；
# 截断时管线会自动拆小批次重试，仍失败则显式报错（不再静默返回空结果）
LLM_MAX_TOKENS=8192

# Bangumi API 令牌（需要配置 DANBOORU_PROXY, 深度翻译非必需）
# 获取方式：https://next.bgm.tv/demo/access-token  创建 access_token
BANGUMI_ACCESS_TOKEN=your-bangumi-access-token

# 视觉模型 API 配置（VLM 自然语言描述打标）
VISION_API_URL=http://127.0.0.1:8081/v1
# 本地部署不校验 Key，留空即可（空值由 config.resolve_api_key 归一化为占位串）
VISION_API_KEY=your-vision-api-key
VISION_MODEL=default
# 单次输出上限。注意这是 reasoning_content + content 的共享额度，
# 推理模型思考模式吃满后正式描述会是空串（日志：模型在思考中，未生成正式描述）
VISION_MAX_TOKENS=1024
# 思考模式开关：off 关闭（推荐，本任务只要 2~3 个短句）；
# on 开启思考（注意：思考模式下服务端会静默忽略 temperature）
VISION_THINKING=off

# 提示词优化器（/prompt_tool）：模型端点复用上面的 VISION_API_URL / VISION_API_KEY / VISION_MODEL
# 一轮跑三次调用（规划 / 带图改写 / 未收录修补），三个都走这里的额度
PROMPT_MAX_TOKENS=8192
# 思考模式开关：off 关闭（推荐，结构化 JSON 任务，思考纯烧钱且会静默吃掉 temperature）
PROMPT_THINKING=off
# 单次调用超时（秒）。注意 tagger.py 的 VLM 路径没传 timeout，这里必须显式传
PROMPT_TIMEOUT=180
# 其余参数不是用户配置：检索口径与图片编码上限（wiki 截断、共现过滤、图片压缩阈值等）
# 写死在 config.py 的 _PROMPT_* 常量；工具的条数与字符预算写死在 prompt_tool.py 的 _TOOL_SPECS

# WD14 Tagger 配置（本地打标）
# 下载地址：https://huggingface.co/SmilingWolf/wd-eva02-large-tagger-v3
WD14_MODEL_PATH=models/wd-eva02-large-tagger-v3
WD14_GENERAL_THRESHOLD=0.3
WD14_CHARACTER_THRESHOLD=0.5

# Real-ESRGAN 超清放大
# 下载地址：https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth
REALESRGAN_MODEL_PATH=models/RealESRGAN_x4plus_anime_6B.pth

# BiRefNet 背景移除（ToonOut 动漫微调）
# BiRefNet 基础模型下载：https://huggingface.co/ZhengPeng7/BiRefNet
# ToonOut 权重下载：https://huggingface.co/joelseytre/toonout
BIREFNET_BASE_MODEL_DIR=models/birefnet-base
BIREFNET_TOONOUT_WEIGHTS=models/toonout.pth

# Danbooru 抓取配置 （https://danbooru.donmai.us/wiki_pages/help:api）
DANBOORU_PROXY=http://127.0.0.1:7897
DANBOORU_USER_NAME=your-danbooru-username
DANBOORU_API_KEY=your-danbooru-api-key